diff --git a/api/test_main.py b/api/test_main.py
new file mode 100644
index 0000000..522ca7b
--- /dev/null
+++ b/api/test_main.py
@@ -0,0 +1,39 @@
+"""Tests that pin the two riskiest behaviours of the members API."""
+from fastapi.testclient import TestClient
+
+from api.main import app
+
+client = TestClient(app)
+COACH = {"x-staff-token": "tok-coach-akanksha"}
+
+# Fields that must never leave the search endpoint — the care view
+# (/api/members/{id}) is the only place the full record belongs.
+CLINICAL_FIELDS = {
+    "mrn", "dob", "diagnosis", "allergies", "medications",
+    "prescriber", "insurance_member_number", "notes", "phone",
+    "email", "address", "last_pain_score", "last_pain_logged",
+}
+
+
+def test_search_requires_auth():
+    assert client.get("/api/members").status_code == 401
+
+
+def test_search_response_contains_no_clinical_fields():
+    """Would have caught F1: search returned full records, incl. on empty q."""
+    for q in ("", "vega"):
+        res = client.get("/api/members", params={"q": q}, headers=COACH)
+        assert res.status_code == 200
+        results = res.json()["results"]
+        assert results, f"expected results for q={q!r}"
+        for m in results:
+            leaked = CLINICAL_FIELDS & m.keys()
+            assert not leaked, f"search leaked clinical fields: {sorted(leaked)}"
+
+
+def test_full_name_search_finds_the_member():
+    """Would have caught F6: 'marisol vega' returned zero results."""
+    res = client.get("/api/members", params={"q": "marisol vega"}, headers=COACH)
+    assert res.status_code == 200
+    ids = [m["member_id"] for m in res.json()["results"]]
+    assert ids == ["88301"]
